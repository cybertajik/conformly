CONFORMLY_ENVIRONMENT=development
CONFORMLY_LOG_LEVEL=INFO
CONFORMLY_DATABASE_URL=postgresql+psycopg://conformly:conformly@postgres:5432/conformly
CONFORMLY_OIDC_ISSUER=
CONFORMLY_OIDC_AUDIENCE=
CONFORMLY_OIDC_JWKS_URL=
CONFORMLY_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Key Management: "local" for dev or "openbao" / "vault" for production & staging.
CONFORMLY_KMS_PROVIDER=openbao
CONFORMLY_VAULT_ENDPOINT=http://localhost:8200
CONFORMLY_VAULT_TOKEN=root
CONFORMLY_VAULT_TRANSIT_MOUNT=transit
CONFORMLY_VAULT_KEY_NAME=conformly-master-key
# Development only: JSON object of version names to base64-encoded 32-byte KEKs.
CONFORMLY_LOCAL_KEKS={}
CONFORMLY_ACTIVE_KEK_VERSION=1
CONFORMLY_CLAMAV_HOST=localhost
CONFORMLY_CLAMAV_PORT=3310
CONFORMLY_INVITATION_TOKEN_PEPPER=
CONFORMLY_STORAGE_BACKEND=s3
CONFORMLY_STORAGE_ENDPOINT=http://localhost:9000
CONFORMLY_STORAGE_BUCKET=conformly-files
CONFORMLY_STORAGE_ACCESS_KEY=conformly_minio
CONFORMLY_STORAGE_SECRET_KEY=conformly_minio_secret
CONFORMLY_STORAGE_REGION=us-east-1
VITE_API_BASE_URL=http://localhost:8000
# Public OIDC Authorization Code + PKCE client configuration (no client secret).
VITE_OIDC_AUTHORIZATION_URL=
VITE_OIDC_TOKEN_URL=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_SCOPES=openid profile email
